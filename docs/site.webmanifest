{
  "name": "MiruShin",
  "short_name": "MiruShin",
  "id": "/",
  "description": "Discover anime, films, and shows. Watch with friends and keep a local-first library across desktop, mobile, and Android TV.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "orientation": "any",
  "lang": "en-US",
  "dir": "ltr",
  "background_color": "#09090d",
  "theme_color": "#09090d",
  "categories": [
    "entertainment",
    "multimedia",
    "utilities"
  ],
  "icons": [
    {
      "src": "assets/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/logo.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/logo.ico",
      "sizes": "32x32",
      "type": "image/x-icon",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "site/media/board.webp",
      "sizes": "1400x1310",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "MiruShin discovery board"
    },
    {
      "src": "site/media/player.webp",
      "sizes": "1400x1310",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "MiruShin desktop player"
    },
    {
      "src": "site/media/mobile-board.webp",
      "sizes": "660x1434",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "MiruShin mobile discovery"
    },
    {
      "src": "site/media/mobile-player.webp",
      "sizes": "660x1434",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "MiruShin mobile player"
    }
  ],
  "shortcuts": [
    {
      "name": "Downloads",
      "short_name": "Downloads",
      "description": "Download the latest MiruShin builds.",
      "url": "/#downloads",
      "icons": [
        {
          "src": "assets/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Privacy Policy",
      "short_name": "Privacy",
      "description": "Read the MiruShin Privacy Policy.",
      "url": "/privacy.html",
      "icons": [
        {
          "src": "assets/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
