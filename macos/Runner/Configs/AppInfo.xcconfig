// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = MiruShin

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.emp0ry.mirushin

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 com.emp0ry. All rights reserved.

// Keep the C ABI entry points discoverable by Dart FFI in dead-stripped builds.
OTHER_LDFLAGS = $(inherited) -Wl,-u,_mirushin_seek_thumbnail_decode -Wl,-u,_mirushin_seek_thumbnail_free -Wl,-u,_mirushin_seek_thumbnail_session_create -Wl,-u,_mirushin_seek_thumbnail_session_reset_cancel -Wl,-u,_mirushin_seek_thumbnail_session_open -Wl,-u,_mirushin_seek_thumbnail_session_decode -Wl,-u,_mirushin_seek_thumbnail_session_cancel -Wl,-u,_mirushin_seek_thumbnail_session_destroy -Wl,-u,_mirushin_seek_thumbnail_output_size
